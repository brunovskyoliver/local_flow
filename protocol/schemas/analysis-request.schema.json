{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localflow.org/schemas/analysis-request.schema.json",
  "title": "LocalFlow meeting analysis request v1",
  "description": "Body of POST /v1/analysis/meeting. No other field is permitted; unknown fields are rejected with invalid_request. Byte limits (segment text <= 4,096 UTF-8 bytes each, body <= 262,144 bytes) are enforced before parsing. The payload contains only the FR-029 meeting text: no audio, embeddings, vocabulary, other meetings, known-speaker lists or Possible-match candidate names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "priority",
    "stage",
    "meeting",
    "participants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique per request; echoed in every event."
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Shared by every request of one run."
    },
    "priority": {
      "type": "string",
      "enum": ["background"]
    },
    "stage": {
      "type": "string",
      "enum": ["full", "chunk", "synthesis"]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "count"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 63 },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "started_at",
        "duration_ms",
        "time_zone",
        "language_policy"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": {
          "type": "string",
          "maxLength": 256,
          "description": "At most 256 UTF-8 bytes; may be empty."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 with offset; the anchor for relative dates."
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA name, at most 64 UTF-8 bytes."
        },
        "language_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output", "preserve_terms"],
          "properties": {
            "output": { "type": "string", "enum": ["sk", "en", "mixed"] },
            "preserve_terms": { "type": "boolean" }
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker_id", "certainty", "origin"],
        "properties": {
          "speaker_id": { "type": "string", "format": "uuid" },
          "certainty": {
            "type": "string",
            "enum": [
              "confirmed",
              "recognized",
              "possible",
              "unknown",
              "local_name",
              "local_user"
            ]
          },
          "origin": { "type": "string", "maxLength": 32 },
          "known_speaker_id": { "type": "string", "format": "uuid" },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "At most 80 UTF-8 bytes; permitted only with confirmed, recognized, local_name or local_user."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "certainty": {
                  "enum": ["confirmed", "recognized", "local_name", "local_user"]
                }
              },
              "required": ["certainty"]
            },
            "else": { "not": { "required": ["name"] } }
          },
          {
            "if": {
              "properties": {
                "certainty": { "enum": ["confirmed", "recognized"] }
              },
              "required": ["certainty"]
            },
            "else": { "not": { "required": ["known_speaker_id"] } }
          }
        ]
      },
      "description": "speaker_id values are unique; name and known_speaker_id rules are enforced by the implementations."
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "speaker_id", "text"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": ["string", "null"], "format": "uuid" },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "At most 4,096 UTF-8 bytes."
          }
        }
      },
      "description": "Ids unique; end_ms >= start_ms; speaker_id null or a participant; present for full and chunk, absent for synthesis."
    },
    "notes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^note:[1-9][0-9]*$" },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "At most 8,192 UTF-8 bytes."
          }
        }
      },
      "description": "Ids strictly increasing; present only for full and synthesis."
    },
    "partials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "./analysis-result.schema.json"
      },
      "description": "Partial results of earlier chunk requests of this run; present only for synthesis."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "chunk" } }, "required": ["stage"] },
      "then": { "required": ["chunk", "segments"], "not": { "required": ["partials", "notes"] } }
    },
    {
      "if": { "properties": { "stage": { "const": "full" } }, "required": ["stage"] },
      "then": { "required": ["segments"], "not": { "required": ["chunk", "partials"] } }
    },
    {
      "if": { "properties": { "stage": { "const": "synthesis" } }, "required": ["stage"] },
      "then": { "required": ["partials"], "not": { "required": ["chunk", "segments"] } }
    }
  ],
  "comment": "chunk.index < chunk.count and note ids strictly increasing are enforced by the implementations."
}
