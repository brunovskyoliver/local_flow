{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localflow.org/schemas/usage-response-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "stale",
        "invalid",
        "revoked",
        "busy"
      ]
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "const": ""
        }
      ]
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "const": ""
        }
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "grant": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "control_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "deletion_cutoff": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "propagation_pending": {
      "type": "boolean"
    },
    "rows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "stale"
            ]
          }
        },
        "required": [
          "day",
          "revision",
          "status"
        ]
      }
    }
  },
  "required": [
    "version",
    "status",
    "user_id",
    "device_id",
    "epoch",
    "enabled",
    "control_revision",
    "deletion_cutoff",
    "propagation_pending",
    "rows"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "grant"
        ]
      },
      "else": {
        "not": {
          "required": [
            "grant"
          ]
        }
      }
    }
  ]
}
