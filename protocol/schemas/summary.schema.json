{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalFlow summary v1 (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "decisions",
    "action_items",
    "risks",
    "follow_up"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 20000
    },
    "decisions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "task",
          "due_date"
        ],
        "properties": {
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "follow_up": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    }
  }
}
