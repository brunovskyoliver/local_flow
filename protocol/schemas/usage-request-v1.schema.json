{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "action": {
      "enum": [
        "status",
        "enable",
        "withdraw",
        "delete_device",
        "delete_user",
        "snapshot"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "grant": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "local_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "remote_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "local_audio_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "remote_audio_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "coverage": {
            "enum": [
              "complete",
              "partial"
            ]
          }
        },
        "required": [
          "day",
          "revision",
          "local_count",
          "remote_count",
          "local_audio_ms",
          "remote_audio_ms",
          "coverage"
        ]
      }
    }
  },
  "required": [
    "version",
    "action"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "snapshot",
              "withdraw",
              "delete_device",
              "delete_user"
            ]
          }
        }
      },
      "then": {
        "required": [
          "epoch",
          "grant"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "epoch"
              ]
            },
            {
              "required": [
                "grant"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "required": [
          "rows"
        ]
      },
      "else": {
        "not": {
          "required": [
            "rows"
          ]
        }
      }
    }
  ]
}
