{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage-row-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "local_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "remote_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "local_audio_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "remote_audio_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ]
    }
  },
  "required": [
    "day",
    "revision",
    "local_count",
    "remote_count",
    "local_audio_ms",
    "remote_audio_ms",
    "coverage"
  ]
}
