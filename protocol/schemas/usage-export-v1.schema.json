{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localflow.org/schemas/usage-export-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "installation": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "control": {
      "$ref": "usage-control-v1.schema.json"
    },
    "rows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "usage-row-v1.schema.json"
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "revision",
        "removed"
      ]
    }
  },
  "required": [
    "installation",
    "control",
    "rows"
  ]
}
