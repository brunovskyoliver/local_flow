{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localflow.org/schemas/rewrite-request.schema.json",
  "title": "LocalFlow rewrite request v1 and v2",
  "description": "Body of POST /v1/rewrite. v2 is v1 plus the required context (Feature 012); a v1 body with context or a v2 body without it is invalid_request. No other field is permitted; servers reject unknown fields with invalid_request. Byte limits (text <= 65,536 UTF-8 bytes, body <= 262,144 bytes, context <= 8,192 bytes) are enforced before parsing.",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rewrite protocol v1 (Feature 003).",
      "required": [
        "schema_version",
        "request_id",
        "mode",
        "text",
        "language_hints",
        "stream_deltas"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "language_hints": {
          "$ref": "#/$defs/language_hints"
        },
        "stream_deltas": {
          "$ref": "#/$defs/stream_deltas"
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rewrite protocol v2: v1 plus reference context (ADR 0023).",
      "required": [
        "schema_version",
        "request_id",
        "mode",
        "text",
        "language_hints",
        "stream_deltas",
        "context"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "language_hints": {
          "$ref": "#/$defs/language_hints"
        },
        "stream_deltas": {
          "$ref": "#/$defs/stream_deltas"
        },
        "context": {
          "$ref": "rewrite-context.schema.json"
        }
      }
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Attempt id, unique per attempt; echoed in every event."
    },
    "mode": {
      "type": "string",
      "enum": [
        "clean",
        "polished",
        "concise"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "description": "1 to 20,000 Unicode scalars, not blank, at most 65,536 UTF-8 bytes."
    },
    "language_hints": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["en", "sk"]
      },
      "description": "Advisory language codes, English or Slovak only; never a translation request."
    },
    "stream_deltas": {
      "type": "boolean"
    }
  }
}
