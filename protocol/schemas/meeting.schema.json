{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalFlow transcript text envelope v1 (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_id",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "meeting_id": {
      "type": "string",
      "format": "uuid"
    },
    "segments": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "speaker_id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "speaker_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        }
      }
    }
  }
}
