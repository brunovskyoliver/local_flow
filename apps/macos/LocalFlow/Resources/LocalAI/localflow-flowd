#!/bin/sh
# launchd entry for @BUNDLE_ID@.flowd, registered by LocalFlow with
# SMAppService. Runs the flowd bundled with this copy of the app, so updating
# the app updates the server.
set -eu
umask 077
contents="$(cd "$(dirname "$0")/../.." && pwd)"
state="$HOME/Library/Application Support/@DIRECTORY@/LocalAI"
LOCALFLOW_BACKEND_TOKEN="$(cat "$state/api-key")"
[ -n "$LOCALFLOW_BACKEND_TOKEN" ]
export LOCALFLOW_BACKEND_TOKEN
logs="$HOME/Library/Logs/@DIRECTORY@"
mkdir -p "$logs"
exec "$contents/Helpers/flowd" serve --listen 127.0.0.1:@FLOWD_PORT@ \
  --backend http://127.0.0.1:@MTPLX_PORT@/v1 --model localflow --log-file "$logs/flowd.log"
