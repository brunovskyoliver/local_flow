cask "localflow" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/brunovskyoliver/local_flow/releases/download/v#{version}/LocalFlow-#{version}-arm64.zip"
  name "LocalFlow"
  desc "Local dictation and meeting transcription"
  homepage "https://github.com/brunovskyoliver/local_flow"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "LocalFlow.app"
  auto_updates true

  caveats <<~EOS
    LocalFlow checks for updates when enabled; you confirm installation in the app.
    Quit LocalFlow before a manual Homebrew upgrade or uninstall.
    The first signed update from an older ad-hoc build may require macOS permission
    and background-item approval again. Settings, recordings and models are preserved.
    Model downloads are handled inside the app, separately from Homebrew.
  EOS
end
